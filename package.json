{
  "name": "interview-room-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "A personal interview practice workspace with evidence, durable sessions and answer retries",
  "author": "xbzz1018",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "launch": "node scripts/launch.mjs",
    "start": "node src/server.ts",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "node scripts/launch-desktop.mjs",
    "package:desktop": "npm run build:desktop && npm run licenses && node scripts/package-desktop.mjs",
    "test:desktop": "node scripts/smoke-desktop.ts",
    "test": "node --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "export:legacy": "node scripts/export-legacy.ts",
    "convert:prep": "node scripts/convert-prep.ts",
    "test:ui": "node scripts/smoke-ui.ts",
    "screenshots": "node scripts/capture-showcase.ts",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.58.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.0",
    "electron": "45.3.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
