{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "types": ["node"], "verbatimModuleSyntax": true, "erasableSyntaxOnly": true
  },
  "include": ["src", "web", "tests", "scripts/*.ts", "vite.config.ts"]
}
